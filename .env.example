# lyrics-ai — example environment
# 1) `cp .env.example .env.local`
# 2) 본인 API 키를 .env.local 에 채우면 dev 환경에서 prompt 없이 자동 사용
# 3) production 배포 시에는 환경변수 비우고 BYO localStorage 흐름 사용 권장
#    (NEXT_PUBLIC_* 은 빌드 시 client bundle 에 인라인되어 모든 사용자에게 노출됨)

NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_ELEVENLABS_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
